# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# next.js
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# environment and secrets — only .env.example is committed
.env
.env.*
