# data that must never be committed
*.dump
*.sql.gz
/backups
/recordings
*.webm
*.m4a
# generated audio fixtures are rebuilt by tests; keep committed fixtures explicit
/tests/fixtures/generated

# misc
.DS_Store
npm-debug.log*
.vercel
